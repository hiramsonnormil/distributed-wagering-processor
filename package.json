{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "description": "Jungle Gaming technical challenge — Distributed Wagering Processor",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/unit",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration --timeout 60000",
    "migration:up": "bun run src/database/migrate.ts up",
    "migration:down": "bun run src/database/migrate.ts down",
    "test:all": "bun test test/unit && bun test test/integration --timeout 60000"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.600.0",
    "@mikro-orm/core": "^6.3.0",
    "@mikro-orm/migrations": "^6.3.0",
    "@mikro-orm/nestjs": "^6.0.2",
    "@mikro-orm/postgresql": "^6.3.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "decimal.js": "^10.4.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.3.0",
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/pg": "8",
    "pg": "8.20.0",
    "typescript": "^5.5.0"
  }
}
